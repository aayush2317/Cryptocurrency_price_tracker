# ─────────────────────────────────────────────────────────────
#  CRYPTOPULSE  –  Environment Variables
#
#  HOW TO USE:
#  1. Copy this file to .env.local  (never commit .env.local)
#  2. Fill in values from your Neon / Supabase / Railway dashboard
#  3. In Vercel → Settings → Environment Variables, add each key
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL connection string (from Neon / Supabase / Railway) ─
#  Format:  postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
POSTGRES_URL="postgresql://neondb_owner:YOURPASSWORD@ep-XXX.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Postgres also exposes these automatically when you add the integration:
POSTGRES_HOST="ep-XXX.us-east-2.aws.neon.tech"
POSTGRES_USER="neondb_owner"
POSTGRES_PASSWORD="YOURPASSWORD"
POSTGRES_DATABASE="neondb"

# ── CoinGecko API (free tier is fine for demo) ────────────────
#  Get a free key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=""

# ── Cron job secret (generate with: openssl rand -hex 32) ────
CRON_SECRET="replace-with-a-random-secret-string"

# ── App URL (auto-set by Vercel in production) ────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
